    {
      "parameters": {
        "jsCode": "// Hàm trích xuất IP, port, domain\nfunction extractIpPortDomain(command) {\n    if (!command) {\n        return { ip: null, port: null, domain: null };\n    }\n\n    // Regex IPv4\n    const ipPattern = /(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)/;\n    const domainPattern = /(?:[a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}/;\n\n    let ip = null, port = null, domain = null;\n\n    // 1. Tìm IP\n    const ipMatch = command.match(ipPattern);\n    if (ipMatch) {\n        ip = ipMatch[0];\n        // Tìm port xuất hiện ngay sau IP (thường là /dev/tcp/IP/PORT)\n        const pos = command.indexOf(ip) + ip.length;\n        const after = command.substring(pos);\n        const numsAfter = after.match(/\\b([0-9]{1,5})\\b/g);\n        if (numsAfter && numsAfter.length > 0) {\n            port = numsAfter[0]; // lấy số đầu tiên sau IP\n        }\n    } else {\n        // 2. Không có IP => tìm domain\n        const domainMatch = command.match(domainPattern);\n        if (domainMatch) {\n            domain = domainMatch[0];\n        }\n        // Lấy số cuối cùng trong lệnh làm port (dự đoán)\n        const allNums = command.match(/\\b([0-9]{1,5})\\b/g);\n        if (allNums && allNums.length > 0) {\n            port = allNums[allNums.length - 1];\n        }\n    }\n\n    return { ip, port, domain };\n}\n\n// Trích xuất decoded_command\nconst decodedCommand = $(\"Webhook\").item.json.body.decoded_command;\n// Gọi hàm và nhận kết quả\nconst { ip, port, domain } = extractIpPortDomain(decodedCommand);\n\n// Tạo object mới chỉ chứa 3 trường\nconst newPayload = {\n  extracted_ip: ip,\n  extracted_port: port,\n  extracted_domain: domain\n};\n\n// In ra log để debug (kiểm tra trong phần Executions)\nconsole.log(`Extracted IP: ${ip}, Port: ${port}, Domain: ${domain}`);\n\n// Trả về item đã cập nhật\nreturn [newPayload];"
      },
