<!-- EXAMPLE
 2026 Jun 20 14:06:55 OPNsense.internal->192.168.1.100 Jun 20 21:06:55 OPNsense.internal audit[93979]: user root authenticated successfully for WebGui [using OPNsense\Auth\Services\WebGui + OPNsense\Auth\Local]
 2026 Jun 20 14:06:55 OPNsense.internal->192.168.1.100 Jun 20 21:06:55 OPNsense.internal audit[93979]: /index.php: Successful login for user 'root' from: 192.168.1.250

-->
<decoder name="opn-audit">
  <prematch>audit ["\w+"]: </prematch>
</decoder>

<decoder name="opn-audit-fields">
  <parent>opn-audit</parent>
  <regex offset="after_parent">("\S+"): ("\S+") ("\S+") for user ("\S+") from ("\S+")  </regex>
  <order>url, status, authentication, user, from </order>
</decoder>