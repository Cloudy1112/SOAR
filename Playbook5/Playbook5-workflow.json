    {
      "parameters": {
        "jsCode": "const b = $json.body;\nconst a = b.data?.audit ?? {};\n\n// Lay file name: uu tien data.audit.file.name, fallback regex tu full_log\nlet file = a.file?.name;\nif (!file) {\n  const m = (b.full_log || \"\").match(/name=\"([^\"]+)\"/);\n  file = m ? m[1] : \"N/A\";\n}\n\n// Lay exe (tien trinh)\nlet proc = a.exe;\nif (!proc) {\n  const m = (b.full_log || \"\").match(/exe=\"([^\"]+)\"/);\n  proc = m ? m[1] : \"N/A\";\n}\n\n// User\n// User: thu nhieu nguon\nlet user = a.uid ?? a.auid ?? a.euid;\nif (!user || user === \"unknown\") {\n  // fallback: regex AUID=\"...\" tu full_log (ten user dang chu)\n  const m = (b.full_log || \"\").match(/AUID=\"([^\"]+)\"/);\n  user = m ? m[1] : \"unknown\";\n}\n\nreturn {\n  os: \"Linux\",\n  agent: b.agent?.name ?? \"N/A\",\n  agentId: b.agent?.id,\n  agentIp: b.agent?.ip ?? \"N/A\",\n  user: user,\n  file: file,\n  process: proc,\n  ruleId: b.rule?.id,\n  ruleDesc: b.rule?.description,\n  time: b.timestamp\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
