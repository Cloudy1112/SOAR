# Playbook 6 - Audit rules: Credential Dumping & Anti-forensics (Ubuntu Agent)
# Vi tri: /etc/audit/rules.d/credential-theft.rules
# Nap: sudo augenrules --load  &&  sudo auditctl -l

# --- Credential Dumping: giam sat doc file mat khau he thong ---
# -p r : giam sat hanh vi READ
-w /etc/shadow -p r -k credential_theft
-w /etc/gshadow -p r -k credential_theft

# --- Anti-forensics: giam sat ghi/xoa cac file log quan trong ---
# -p wa : giam sat WRITE va ATTRIBUTE change (bat duoc truncate, rm, sua noi dung)
-w /var/log/auth.log -p wa -k anti_forensics
-w /var/log/syslog -p wa -k anti_forensics
