<!-- Example -->
<group name="local,syslog,sshd">
  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5</group>
  </rule>
</group>

<!--
  BRUTE FORCE ATTACKS - MITRE T1110
-->
<group name="local,brute_force,mitre_attack,t1110">
  <rule id="100600" level="12" frequency="10" timeframe="120">
    <if_matched_sid>5758</if_matched_sid>
    <same_srcip />
    <description>SSH Bruteforce confirmed from same IP</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

</group>

<group name="windows_persistence,">

  <!-- Rule cho Registry Run Keys (Event 13 - SetValue) -->
  <rule id="100010" level="10">
    <if_sid>61610</if_sid> <!-- Sysmon Event 13 base -->
    <field name="win.eventdata.TargetObject" type="pcre2">(?i)CurrentVersion\\(Run|RunOnce|RunOnceEx)</field>
    <description>Phát hiện giá trị Registry Run/RunOnce được thay đổi bởi $(win.eventdata.Image)</description>
  </rule>

  <!-- Rule cho Winlogon Helper DLL (Event 13) -->
  <rule id="100011" level="12">
    <if_sid>61610</if_sid>
    <field name="win.eventdata.TargetObject" type="pcre2">(?i)Winlogon\\(Shell|Userinit|Notify|GinaDLL)</field>
    <description>Phát hiện thay đổi Winlogon Helper Registry bởi $(win.eventdata.Image)</description>
  </rule>

  <!-- Rule cho LSA / SSP / Authentication Package (Event 13) -->
  <rule id="100012" level="12">
    <if_sid>61610</if_sid>
    <field name="win.eventdata.TargetObject" type="pcre2">(?i)Control\\Lsa\\(Security Packages|Authentication Packages|Notification Packages)</field>
    <description>Phát hiện thay đổi LSA Security/Authentication Packages bởi $(win.eventdata.Image)</description>
  </rule>

  <!-- Rule cho Active Setup (Event 13) -->
  <rule id="100013" level="10">
    <if_sid>61610</if_sid>
    <field name="win.eventdata.TargetObject" type="pcre2">(?i)Active Setup\\Installed Components\\.+\\StubPath</field>
    <description>Phát hiện thay đổi Active Setup StubPath bởi $(win.eventdata.Image)</description>
  </rule>

  <!-- Rule cho Time Providers (Event 13) -->
  <rule id="100014" level="11">
    <if_sid>61610</if_sid>
    <field name="win.eventdata.TargetObject" type="pcre2">(?i)Services\\W32Time\\TimeProviders\\.+\\DllName</field>
    <description>Phát hiện thay đổi Windows Time Provider bởi $(win.eventdata.Image)</description>
  </rule>

  <!-- Rule cho Print Monitors / Processors (Event 13) -->
  <rule id="100030" level="11">
    <if_sid>61610</if_sid>
    <field name="win.eventdata.TargetObject" type="pcre2">(?i)Control\\Print\\(Monitors|Environments)</field>
    <description>Phát hiện cài đặt Port Monitor hoặc Print Processor bởi $(win.eventdata.Image)</description>
  </rule>

  <!-- Rule cho Startup Folder - tạo file (Event 11 - FileCreate) -->
  <!-- Rule cha cho Sysmon Event 11 là 61608 -->
  <rule id="100020" level="7">
    <if_sid>61608</if_sid> <!-- Sysmon Event 11 base -->
    <field name="win.eventdata.TargetFilename" type="pcre2">(?i)C:\\\\Users\\\\.+\\\\AppData\\\\Roaming\\\\Microsoft\\\\Windows\\\\Start Menu\\\\Programs\\\\Startup\\\\.+\.(lnk|exe|bat|vbs|ps1)|(?i)C:\\\\ProgramData\\\\Microsoft\\\\Windows\\\\Start Menu\\\\Programs\\\\Startup\\\\.+\.(lnk|exe|bat|vbs|ps1)</field>
    <description>Phát hiện file được tạo trong thư mục Startup bởi $(win.eventdata.Image)</description>
  </rule>

</group>


<group name="windows, sysmon, vssadmin_monitor">
  <rule id="100080" level="7">
    <if_group>sysmon_event1</if_group> <!-- ID gốc xử lý sự kiện Sysmon Event ID 1 (Process Creation) -->
    <field name="win.eventdata.commandLine" type="pcre2">(?i)vssadmin|wmic|shadowcopy|shadowstorage</field>
    <description>Executed command in cmdline: $(win.eventdata.commandLine)</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100090" level="0">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID">^4688$</field>
    <description> Log Windows Event ID 4688 from decoder JSON.</description>
  </rule>

  <rule id="100091" level="12">
    <if_sid>100090</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)vssadmin|wmic|shadowcopy|shadowstorage</field>
    <description>Executed command in cmdline: $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1490</id> <!-- Kỹ thuật Inhibit System Recovery của MITRE ATT&CK -->
    </mitre>
    <group>vss_deletion,ransomware_behavior,</group>
  </rule>

</group>

<!-- WEB SHELL DETECTION -->
<group name="linux, webshell, windows,">
  <!-- This rule detects file creation. -->
  <rule id="100700" level="12">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i).php$|.phtml$|.php3$|.php4$|.php5$|.phps$|.phar$|.asp$|.aspx$|.jsp$|.cshtml$|.vbhtml$</field>
    <description>[File creation]: Possible web shell scripting file ($(file)) created</description>
    <mitre>
      <id>T1105</id>
      <id>T1505</id>
    </mitre>
  </rule>
  
  <!-- This rule detects file modification. -->
  <rule id="100701" level="12">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">(?i).php$|.phtml$|.php3$|.php4$|.php5$|.phps$|.phar$|.asp$|.aspx$|.jsp$|.cshtml$|.vbhtml$</field>
    <description>[File modification]: Possible web shell content added in $(file)</description>
    <mitre>
      <id>T1105</id>
      <id>T1505</id>
    </mitre>
  </rule>

  <!-- This rule detects files modified with PHP web shell signatures. -->
  <rule id="100702" level="15">
    <if_sid>100701</if_sid>
    <field name="changed_content" type="pcre2">(?i)passthru|exec|eval|shell_exec|assert|str_rot13|system|phpinfo|base64_decode|chmod|mkdir|fopen|fclose|readfile|show_source|proc_open|pcntl_exec|execute|WScript.Shell|WScript.Network|FileSystemObject|Adodb.stream</field>
    <description>[File Modification]: File $(file) contains a web shell</description>
    <mitre>
      <id>T1105</id>
      <id>T1505.003</id>
    </mitre>
  </rule>
</group>

<!-- This rule detects network connections from scripts. -->
<group name="linux, webshell,">
  <rule id="100710" level="12">
    <decoded_as>ossec</decoded_as>
    <match>ossec: output: 'webshell connections'</match>
    <description>[Network connection]: Script attempting network connection on source port: $(local_port) and destination port: $(foreign_port)</description>
    <mitre>
      <id>TA0011</id>
      <id>T1049</id>
      <id>T1505.003</id>
    </mitre>
  </rule>

  <rule id="100720" level="12">
    <if_sid>80700</if_sid>
    <field name="audit.key">webshell_command_exec</field>
    <description>Webshell Executed System Command via Web Server (User: www-data)</description>
    <mitre>
      <id>T1505.003</id>
      <id>T1059.004</id>
    </mitre>
  </rule>

  <rule id="100721" level="12">
    <if_sid>80700</if_sid>
    <field name="audit.key">webshell_net_connect</field>
    <description>Webshell Initiated Outbound Network Connection (Reverse Shell)</description>
    <mitre>
      <id>TA0011</id>
      <id>T1049</id>
    </mitre>
  </rule>

</group>

<!--
  Playbook 5 - Phát hiện & ngăn chặn rò rỉ dữ liệu nội bộ
  File: /var/ossec/etc/rules/local_rules.xml (trong container Manager)
  Chỉ trích phần rule liên quan Playbook 5.
-->
<group name="local,syslog,sshd,">

  <!-- ===== Playbook 5: Data Leak Detection ===== -->

  <!-- A. Linux: Truy cập dữ liệu nhạy cảm (qua auditd key) -->
  <rule id="100500" level="10">
    <if_group>audit</if_group>
    <field name="audit.key">sensitive_data</field>
    <description>Linux Sensitive Data Access Detected</description>
    <mitre>
      <id>T1005</id>
    </mitre>
  </rule>

  <!-- C. Linux: Trình duyệt truy cập file nhạy cảm -> nghi ngờ upload -->
  <rule id="100520" level="12">
    <if_sid>100500</if_sid>
    <match>firefox|chrome|chromium</match>
    <description>Potential Data Exfiltration: Browser accessed sensitive file on Linux</description>
    <mitre>
      <id>T1567</id>
    </mitre>
  </rule>

  <!-- A. Windows: Truy cập dữ liệu nhạy cảm (Event ID 4663 trên C:\Sensitive) -->
  <rule id="100510" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4663$</field>
    <field name="win.eventdata.objectName">Sensitive</field>
    <description>Windows Sensitive Data Access Detected</description>
    <mitre>
      <id>T1005</id>
    </mitre>
  </rule>

  <!-- C. Windows: Trình duyệt truy cập file nhạy cảm -> nghi ngờ upload -->
  <rule id="100530" level="12">
    <if_sid>100510</if_sid>
    <field name="win.eventdata.processName">msedge|chrome</field>
    <description>Potential Data Exfiltration: Browser accessed sensitive file on Windows</description>
    <mitre>
      <id>T1567</id>
    </mitre>
  </rule>

</group>

<!--
  Playbook 6 - Credential Dumping & Anti-forensics
  File: /var/ossec/etc/rules/local_rules.xml (trong container Manager)
  Chi trich phan rule lien quan Playbook 6.
-->
<group name="local,syslog,sshd,">

  <!-- ===== Playbook 6: Credential Dumping & Anti-forensics ===== -->

  <!-- Credential Dumping: doc file mat khau he thong (/etc/shadow, /etc/gshadow) -->
  <!-- ignore="10": chong trung, moi 10s chi 1 alert cho cung rule -->
  <rule id="100600" level="12" ignore="10">
    <if_group>audit</if_group>
    <field name="audit.key">credential_theft</field>
    <description>Credential Dumping: Phat hien doc file mat khau he thong</description>
    <mitre>
      <id>T1003</id>
    </mitre>
  </rule>

  <!-- Loai tru tien trinh he thong + sudo doc shadow hop le (giam false positive) -->
  <!-- sudo doc shadow de xac thuc la binh thuong; chi canh bao khi cat/less/cp... doc -->
  <rule id="100601" level="3" ignore="10">
    <if_sid>100600</if_sid>
    <field name="audit.exe">sudo|cron|systemd|unix_chkpwd|sshd|login|/usr/sbin/</field>
    <description>Credential file access by system/auth process (benign)</description>
  </rule>

  <!-- Anti-forensics: xoa/sua/lam rong file log he thong -->
  <!-- level 13 (cao nhat): xoa log la dau hieu che giau xam nhap nghiem trong -->
  <rule id="100610" level="13" ignore="10">
    <if_group>audit</if_group>
    <field name="audit.key">anti_forensics</field>
    <description>Anti-forensics: Phat hien hanh vi xoa/sua file log he thong</description>
    <mitre>
      <id>T1070</id>
    </mitre>
  </rule>

</group>

