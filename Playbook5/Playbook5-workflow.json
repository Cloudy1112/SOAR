      "parameters": {
        "jsCode": "const b = $json.body;\nconst e = b.data?.win?.eventdata ?? {};\n\nconst clean = (s) => (s ?? \"N/A\").replace(/\\\\\\\\/g, \"\\\\\");\n\nreturn {\n  os: \"Windows\",\n  agent: b.agent?.name ?? \"N/A\",\n  agentIp: b.agent?.ip ?? \"N/A\",\n  agentId: b.agent?.id,\n  user: e.subjectUserName ?? \"unknown\",\n  file: clean(e.objectName),\n  process: clean(e.processName),\n  ruleId: b.rule?.id,\n  ruleDesc: b.rule?.description,\n  time: b.timestamp\n};"
      },
