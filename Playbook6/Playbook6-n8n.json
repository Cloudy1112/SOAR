        "jsCode": "const b = $json.body;\nconst a = b.data?.audit ?? {};\n\n// Lay ten user (dang chu) tu full_log\nlet user = a.auid;\nconst m = (b.full_log || \"\").match(/AUID=\"([^\"]+)\"/);\nif (m) user = m[1];\n\nreturn {\n  type: b.rule.id === \"100600\" ? \"Credential Dumping (Đánh cắp mật khẩu hệ thống)\" : \"Anti-forensics (Xóa dấu vết)\",\n  severity: b.rule.id === \"100610\" ? \"KHẨN CẤP\" : \"Cao\",\n  agent: b.agent?.name ?? \"N/A\",\n  agentIp: b.agent?.ip ?? \"N/A\",\n  agentId: b.agent?.id,\n  user: user ?? \"unknown\",\n  process: a.exe ?? \"N/A\",\n  file: a.file?.name ?? \"N/A\",\n  ruleId: b.rule.id,\n  ruleDesc: b.rule.description,\n  mitre: b.rule?.mitre?.id?.[0] ?? \"\",\n  time: b.timestamp\n};"
      },
